   "end": 50.22,
   "words": [
    {
     "text": "Земля",
     "start": 48.177,
     "end": 48.595
    },
    {
     "text": "летит",
     "start": 48.653,
     "end": 48.885
    },
    {
     "text": "прямо",
     "start": 48.943,
     "end": 49.175
    },
    {
     "text": "в",
     "start": 49.21,
     "end": 49.234
    },
    {
     "text": "лобовое",
     "start": 49.292,
     "end": 49.628
    },
    {
     "text": "стекло.",
     "start": 49.663,
     "end": 50.22
    }
   ]
  },
  {
   "id": 26,
   "speaker": "narrator",
   "text": "Руки сами дёргают штурвал.",
   "start": 50.47,
   "end": 52.049,
   "words": [
