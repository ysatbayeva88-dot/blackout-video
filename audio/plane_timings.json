     "start": 57.619,
     "end": 57.863
    },
    {
     "text": "на",
     "start": 57.921,
     "end": 58.002
    },
    {
     "text": "ноль.",
     "start": 58.049,
     "end": 58.594
    }
   ]
  },
  {
   "id": 29,
   "speaker": "narrator",
   "text": "Тридцать метров.",
   "start": 58.964,
   "end": 59.986,
