{
 "duration": 63.558,
 "segments": [
  {
   "id": 0,
   "speaker": "narrator",
   "text": "Пилот без сознания. Штурвал теперь у тебя.",
   "start": 0.0,
   "end": 2.368,
   "words": [
    {
     "text": "Пилот",
     "start": 0.0,
     "end": 0.302
    },
    {
     "text": "без",
     "start": 0.348,
     "end": 0.464
    },
    {
     "text": "сознания.",
     "start": 0.488,
     "end": 0.998
    },
    {
     "text": "Штурвал",
     "start": 1.08,
     "end": 1.451
    },
    {
     "text": "теперь",
     "start": 1.509,
     "end": 1.753
    },
    {
     "text": "у",
     "start": 1.776,
     "end": 1.8
    },
    {
     "text": "тебя.",
     "start": 1.846,
     "end": 2.368
    }
   ]
  },
  {
   "id": 1,
   "speaker": "narrator",
   "text": "Я, Алихан. Слушай меня внимательно.",
   "start": 2.568,
   "end": 4.751,
   "words": [
    {
     "text": "Я,",
     "start": 2.568,
     "end": 3.009
    },
    {
     "text": "Алихан.",
     "start": 3.079,
     "end": 3.543
    },
    {
     "text": "Слушай",
     "start": 3.601,
     "end": 3.88
    },
    {
     "text": "меня",
     "start": 3.903,
     "end": 4.042
    },
    {
     "text": "внимательно.",
     "start": 4.077,
     "end": 4.751
    }
   ]
  },
  {
   "id": 2,
   "speaker": "narrator",
   "text": "За бортом, восемьсот километров в час.",
   "start": 4.951,
   "end": 7.18,
   "words": [
    {
     "text": "За",
     "start": 4.951,
     "end": 5.09
    },
    {
     "text": "бортом,",
     "start": 5.125,
     "end": 5.508
    },
    {
     "text": "восемьсот",
     "start": 5.613,
     "end": 6.054
    },
    {
     "text": "километров",
     "start": 6.1,
     "end": 6.576
    },
    {
     "text": "в",
     "start": 6.634,
     "end": 6.681
    },
    {
     "text": "час.",
     "start": 6.751,
     "end": 7.18
    }
   ]
  },
  {
   "id": 3,
   "speaker": "narrator",
   "text": "Под тобой десять тысяч метров пустоты.",
   "start": 7.53,
   "end": 9.713,
   "words": [
    {
     "text": "Под",
     "start": 7.53,
     "end": 7.785
    },
    {
     "text": "тобой",
     "start": 7.855,
     "end": 8.076
    },
    {
     "text": "десять",
     "start": 8.122,
     "end": 8.424
    },
    {
     "text": "тысяч",
     "start": 8.482,
     "end": 8.726
    },
    {
     "text": "метров",
     "start": 8.784,
     "end": 9.039
    },
    {
     "text": "пустоты.",
     "start": 9.097,
     "end": 9.713
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Не паникуй.",
   "start": 9.913,
   "end": 10.795,
   "words": [
    {
     "text": "Не",
     "start": 9.913,
     "end": 10.18
    },
    {
     "text": "паникуй.",
     "start": 10.215,
     "end": 10.795
    }
   ]
  },
  {
   "id": 5,
   "speaker": "narrator",
   "text": "Надень наушники пилота.",
   "start": 10.995,
   "end": 12.528,
   "words": [
    {
     "text": "Надень",
     "start": 10.995,
     "end": 11.471
    },
    {
     "text": "наушники",
     "start": 11.517,
     "end": 11.924
    },
    {
     "text": "пилота.",
     "start": 11.959,
     "end": 12.528
    }
   ]
  },
  {
   "id": 6,
   "speaker": "narrator",
   "text": "Найди кнопку на штурвале.",
   "start": 12.728,
   "end": 14.26,
   "words": [
    {
     "text": "Найди",
     "start": 12.728,
     "end": 13.041
    },
    {
     "text": "кнопку",
     "start": 13.076,
     "end": 13.401
    },
    {
     "text": "на",
     "start": 13.436,
     "end": 13.483
    },
    {
     "text": "штурвале.",
     "start": 13.517,
     "end": 14.261
    }
   ]
  },
  {
   "id": 7,
   "speaker": "narrator",
   "text": "Зажми и скажи: «Мэйдэй, Мэйдэй, Мэйдэй».",
   "start": 14.46,
   "end": 17.154,
   "words": [
    {
     "text": "Зажми",
     "start": 14.46,
     "end": 14.75
    },
    {
     "text": "и",
     "start": 14.797,
     "end": 14.82
    },
    {
     "text": "скажи:",
     "start": 14.855,
     "end": 15.238
    },
    {
     "text": "«Мэйдэй,",
     "start": 15.308,
     "end": 15.946
    },
    {
     "text": "Мэйдэй,",
     "start": 16.004,
     "end": 16.48
    },
    {
     "text": "Мэйдэй».",
     "start": 16.538,
     "end": 17.154
    }
   ]
  },
  {
   "id": 8,
   "speaker": "narrator",
   "text": "Тишина.",
   "start": 17.504,
   "end": 18.34,
   "words": [
    {
     "text": "Тишина.",
     "start": 17.504,
     "end": 18.34
    }
   ]
  },
  {
   "id": 9,
   "speaker": "narrator",
   "text": "И вдруг —",
   "start": 18.54,
   "end": 19.287,
   "words": [
    {
     "text": "И",
     "start": 18.54,
     "end": 18.772
    },
    {
     "text": "вдруг",
     "start": 18.83,
     "end": 19.167
    }
   ]
  },
  {
   "id": 10,
   "speaker": "dispatcher",
   "text": "Слышу вас. Автопилот не трогайте.",
   "start": 19.487,
   "end": 21.972,
   "words": [
    {
     "text": "Слышу",
     "start": 19.577,
     "end": 20.053
    },
    {
     "text": "вас.",
     "start": 20.088,
     "end": 20.378
    },
    {
     "text": "Автопилот",
     "start": 20.448,
     "end": 20.947
    },
    {
     "text": "не",
     "start": 20.993,
     "end": 21.063
    },
    {
     "text": "трогайте.",
     "start": 21.11,
     "end": 21.853
    }
   ]
  },
  {
   "id": 11,
   "speaker": "narrator",
   "text": "Видишь зелёную надпись «Эй-Пи»?",
   "start": 22.172,
   "end": 24.123,
   "words": [
    {
     "text": "Видишь",
     "start": 22.172,
     "end": 22.555
    },
    {
     "text": "зелёную",
     "start": 22.59,
     "end": 22.892
    },
    {
     "text": "надпись",
     "start": 22.938,
     "end": 23.252
    },
    {
     "text": "«Эй-Пи»?",
     "start": 23.333,
     "end": 24.122
    }
   ]
  },
  {
   "id": 12,
   "speaker": "dispatcher",
   "text": "Крутите ручку высоты. Снижаемся до трёхсот метров.",
   "start": 24.323,
   "end": 27.644,
   "words": [
    {
     "text": "Крутите",
     "start": 24.413,
     "end": 24.877
    },
    {
     "text": "ручку",
     "start": 24.912,
     "end": 25.191
    },
    {
     "text": "высоты.",
     "start": 25.214,
     "end": 25.678
    },
    {
     "text": "Снижаемся",
     "start": 25.841,
     "end": 26.375
    },
    {
     "text": "до",
     "start": 26.433,
     "end": 26.514
    },
    {
     "text": "трёхсот",
     "start": 26.549,
     "end": 26.898
    },
    {
     "text": "метров.",
     "start": 26.956,
     "end": 27.524
    }
   ]
  },
  {
   "id": 13,
   "speaker": "narrator",
   "text": "Нос опускается. Самолёт ныряет в облака.",
   "start": 27.844,
   "end": 30.306,
   "words": [
    {
     "text": "Нос",
     "start": 27.844,
     "end": 28.053
    },
    {
     "text": "опускается.",
     "start": 28.134,
     "end": 28.831
    },
    {
     "text": "Самолёт",
     "start": 28.889,
     "end": 29.26
    },
    {
     "text": "ныряет",
     "start": 29.307,
     "end": 29.574
    },
    {
     "text": "в",
     "start": 29.62,
     "end": 29.644
    },
    {
     "text": "облака.",
     "start": 29.678,
     "end": 30.305
    }
   ]
  },
  {
   "id": 14,
   "speaker": "narrator",
   "text": "Внизу, огни города. И полоса.",
   "start": 30.656,
   "end": 32.978,
   "words": [
    {
     "text": "Внизу,",
     "start": 30.656,
     "end": 31.353
    },
    {
     "text": "огни",
     "start": 31.399,
     "end": 31.701
    },
    {
     "text": "города.",
     "start": 31.759,
     "end": 32.2
    },
    {
     "text": "И",
     "start": 32.247,
     "end": 32.305
    },
    {
     "text": "полоса.",
     "start": 32.363,
     "end": 32.978
    }
   ]
  },
  {
   "id": 15,
   "speaker": "narrator",
   "text": "Выпускаешь закрылки.",
   "start": 33.178,
   "end": 34.431,
   "words": [
    {
     "text": "Выпускаешь",
     "start": 33.178,
     "end": 33.782
    },
    {
     "text": "закрылки.",
     "start": 33.817,
     "end": 34.432
    }
   ]
  },
  {
   "id": 16,
   "speaker": "narrator",
   "text": "Опускаешь шасси.",
   "start": 34.631,
   "end": 36.071,
   "words": [
    {
     "text": "Опускаешь",
     "start": 34.631,
     "end": 35.223
    },
    {
     "text": "шасси.",
     "start": 35.328,
     "end": 36.071
    }
   ]
  },
  {
   "id": 17,
   "speaker": "narrator",
   "text": "Три зелёные лампы.",
   "start": 36.271,
   "end": 37.386,
   "words": [
    {
     "text": "Три",
     "start": 36.271,
     "end": 36.515
    },
    {
     "text": "зелёные",
     "start": 36.55,
     "end": 36.875
    },
    {
     "text": "лампы.",
     "start": 36.921,
     "end": 37.386
    }
   ]
  },
  {
   "id": 18,
   "speaker": "narrator",
   "text": "И тут, порыв ветра.",
   "start": 37.736,
   "end": 39.222,
   "words": [
    {
     "text": "И",
     "start": 37.736,
     "end": 37.945
    },
    {
     "text": "тут,",
     "start": 38.015,
     "end": 38.27
    },
    {
     "text": "порыв",
     "start": 38.375,
     "end": 38.63
    },
    {
     "text": "ветра.",
     "start": 38.711,
     "end": 39.222
    }
   ]
  },
  {
   "id": 19,
   "speaker": "narrator",
   "text": "Самолёт резко кренит влево.",
   "start": 39.422,
   "end": 41.001,
   "words": [
    {
     "text": "Самолёт",
     "start": 39.422,
     "end": 39.91
    },
    {
     "text": "резко",
     "start": 39.968,
     "end": 40.188
    },
    {
     "text": "кренит",
     "start": 40.235,
     "end": 40.513
    },
    {
     "text": "влево.",
     "start": 40.548,
     "end": 41.001
    }
   ]
  },
  {
   "id": 20,
   "speaker": "narrator",
   "text": "Руки сами дёргают штурвал.",
   "start": 41.201,
   "end": 42.78,
   "words": [
    {
     "text": "Руки",
     "start": 41.201,
     "end": 41.573
    },
    {
     "text": "сами",
     "start": 41.619,
     "end": 41.805
    },
    {
     "text": "дёргают",
     "start": 41.84,
     "end": 42.176
    },
    {
     "text": "штурвал.",
     "start": 42.223,
     "end": 42.78
    }
   ]
  },
  {
   "id": 21,
   "speaker": "narrator",
   "text": "Стоп. Плавно. Крылья ровно.",
   "start": 43.13,
   "end": 44.987,
   "words": [
    {
     "text": "Стоп.",
     "start": 43.13,
     "end": 43.502
    },
    {
     "text": "Плавно.",
     "start": 43.56,
     "end": 43.978
    },
    {
     "text": "Крылья",
     "start": 44.047,
     "end": 44.372
    },
    {
     "text": "ровно.",
     "start": 44.419,
     "end": 44.988
    }
   ]
  },
  {
   "id": 22,
   "speaker": "dispatcher",
   "text": "Отключайте автопилот. Нос чуть вверх. Газ на ноль.",
   "start": 45.187,
   "end": 49.345,
   "words": [
    {
     "text": "Отключайте",
     "start": 45.277,
     "end": 45.939
    },
    {
     "text": "автопилот.",
     "start": 45.985,
     "end": 46.728
    },
    {
     "text": "Нос",
     "start": 46.984,
     "end": 47.204
    },
    {
     "text": "чуть",
     "start": 47.262,
     "end": 47.425
    },
    {
     "text": "вверх.",
     "start": 47.46,
     "end": 47.843
    },
    {
     "text": "Газ",
     "start": 48.249,
     "end": 48.493
    },
    {
     "text": "на",
     "start": 48.551,
     "end": 48.632
    },
    {
     "text": "ноль.",
     "start": 48.679,
     "end": 49.224
    }
   ]
  },
  {
   "id": 23,
   "speaker": "narrator",
   "text": "Тридцать метров.",
   "start": 49.545,
   "end": 50.566,
   "words": [
    {
     "text": "Тридцать",
     "start": 49.545,
     "end": 50.033
    },
    {
     "text": "метров.",
     "start": 50.079,
     "end": 50.567
    }
   ]
  },
  {
   "id": 24,
   "speaker": "narrator",
   "text": "Десять.",
   "start": 50.766,
   "end": 51.602,
   "words": [
    {
     "text": "Десять.",
     "start": 50.766,
     "end": 51.602
    }
   ]
  },
  {
   "id": 25,
   "speaker": "narrator",
   "text": "Пять.",
   "start": 51.802,
   "end": 52.545,
   "words": [
    {
     "text": "Пять.",
     "start": 51.802,
     "end": 52.545
    }
   ]
  },
  {
   "id": 26,
   "speaker": "narrator",
   "text": "Касание!",
   "start": 53.145,
   "end": 53.981,
   "words": [
    {
     "text": "Касание!",
     "start": 53.145,
     "end": 53.981
    }
   ]
  },
  {
   "id": 27,
   "speaker": "narrator",
   "text": "Реверс. Тормоза до упора.",
   "start": 54.181,
   "end": 55.807,
   "words": [
    {
     "text": "Реверс.",
     "start": 54.181,
     "end": 54.645
    },
    {
     "text": "Тормоза",
     "start": 54.68,
     "end": 55.063
    },
    {
     "text": "до",
     "start": 55.121,
     "end": 55.191
    },
    {
     "text": "упора.",
     "start": 55.238,
     "end": 55.806
    }
   ]
  },
  {
   "id": 28,
   "speaker": "narrator",
   "text": "Ты на земле. Живой.",
   "start": 56.157,
   "end": 57.457,
   "words": [
    {
     "text": "Ты",
     "start": 56.157,
     "end": 56.378
    },
    {
     "text": "на",
     "start": 56.424,
     "end": 56.482
    },
    {
     "text": "земле.",
     "start": 56.517,
     "end": 56.854
    },
    {
     "text": "Живой.",
     "start": 56.958,
     "end": 57.457
    }
   ]
  },
  {
   "id": 29,
   "speaker": "narrator",
   "text": "Честно: в реальности так делают только по командам диспетчера.",
   "start": 57.657,
   "end": 60.815,
   "words": [
    {
     "text": "Честно:",
     "start": 57.657,
     "end": 58.156
    },
    {
     "text": "в",
     "start": 58.226,
     "end": 58.261
    },
    {
     "text": "реальности",
     "start": 58.307,
     "end": 58.76
    },
    {
     "text": "так",
     "start": 58.806,
     "end": 58.934
    },
    {
     "text": "делают",
     "start": 58.992,
     "end": 59.294
    },
    {
     "text": "только",
     "start": 59.352,
     "end": 59.607
    },
    {
     "text": "по",
     "start": 59.642,
     "end": 59.712
    },
    {
     "text": "командам",
     "start": 59.747,
     "end": 60.107
    },
    {
     "text": "диспетчера.",
     "start": 60.153,
     "end": 60.815
    }
   ]
  },
  {
   "id": 30,
   "speaker": "narrator",
   "text": "А ты бы справился? Пиши в комментариях.",
   "start": 61.015,
   "end": 63.058,
   "words": [
    {
     "text": "А",
     "start": 61.015,
     "end": 61.108
    },
    {
     "text": "ты",
     "start": 61.154,
     "end": 61.224
    },
    {
     "text": "бы",
     "start": 61.259,
     "end": 61.328
    },
    {
     "text": "справился?",
     "start": 61.363,
     "end": 61.932
    },
    {
     "text": "Пиши",
     "start": 61.967,
     "end": 62.199
    },
    {
     "text": "в",
     "start": 62.222,
     "end": 62.246
    },
    {
     "text": "комментариях.",
     "start": 62.292,
     "end": 63.058
    }
   ]
  }
 ]
}