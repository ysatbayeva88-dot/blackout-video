     "end": 42.755
    }
   ]
  },
  {
   "id": 22,
   "speaker": "narrator",
   "text": "Полоса всё ближе.",
   "start": 43.004,
   "end": 44.212,
   "words": [
    {
     "text": "Полоса",
     "start": 43.004,
     "end": 43.434
    },
    {
     "text": "всё",
     "start": 43.468,
     "end": 43.608
    },
    {
     "text": "ближе.",
     "start": 43.666,
     "end": 44.211
    }
   ]
  },
  {
   "id": 23,
   "speaker": "narrator",
   "text": "И тут, порыв ветра.",
   "start": 44.612,
   "end": 46.098,
   "words": [
    {
     "text": "И",
     "start": 44.612,
     "end": 44.821
    },
    {
     "text": "тут,",
     "start": 44.891,
     "end": 45.146
    },
    {
     "text": "порыв",
     "start": 45.251,
     "end": 45.506
    },
    {
     "text": "ветра.",
     "start": 45.587,
     "end": 46.098
