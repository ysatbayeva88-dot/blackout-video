   "end": 2.368,
   "words": [
    {
     "text": "Пилот",
     "start": 0.0,
     "end": 0.302
    },
    {
     "text": "без",
     "start": 0.348,
     "end": 0.464
    },
    {
     "text": "сознания.",
     "start": 0.488,
     "end": 0.998
    },
    {
     "text": "Штурвал",
     "start": 1.08,
     "end": 1.451
    },
    {
     "text": "теперь",
     "start": 1.509,
     "end": 1.753
    },
    {
     "text": "у",
     "start": 1.776,
     "end": 1.8
    },
    {
     "text": "тебя.",
     "start": 1.846,
     "end": 2.368
    }
   ]
  },
  {
   "id": 1,
   "speaker": "narrator",
   "text": "Я, Асность. Слушай меня внимательно.",
   "start": 2.618,
   "end": 4.94,
   "words": [
    {
     "text": "Я,",
     "start": 2.618,
     "end": 3.048
    },
    {
     "text": "Асность.",
     "start": 3.152,
     "end": 3.616
    },
    {
     "text": "Слушай",
     "start": 3.686,
     "end": 4.034
    },
    {
     "text": "меня",
     "start": 4.069,
     "end": 4.232
    },
    {
     "text": "внимательно.",
     "start": 4.267,
     "end": 4.94
    }
   ]
  },
  {
   "id": 2,
   "speaker": "narrator",
   "text": "Под тобой десять тысяч метров пустоты.",
   "start": 5.34,
   "end": 7.523,
   "words": [
    {
     "text": "Под",
     "start": 5.34,
     "end": 5.595
    },
    {
     "text": "тобой",
     "start": 5.665,
     "end": 5.886
    },
    {
     "text": "десять",
     "start": 5.932,
     "end": 6.234
    },
    {
     "text": "тысяч",
     "start": 6.292,
     "end": 6.536
    },
    {
     "text": "метров",
     "start": 6.594,
     "end": 6.849
    },
    {
     "text": "пустоты.",
     "start": 6.907,
     "end": 7.523
    }
   ]
  },
  {
   "id": 3,
   "speaker": "narrator",
   "text": "Не паникуй.",
   "start": 7.773,
   "end": 8.655,
   "words": [
    {
     "text": "Не",
     "start": 7.773,
     "end": 8.04
    },
    {
     "text": "паникуй.",
     "start": 8.075,
     "end": 8.655
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Руки дрожат, это нормально.",
   "start": 8.905,
   "end": 10.717,
   "words": [
    {
     "text": "Руки",
     "start": 8.905,
     "end": 9.288
    },
    {
     "text": "дрожат,",
     "start": 9.335,
     "end": 9.764
    },
    {
     "text": "это",
     "start": 9.869,
     "end": 10.008
    },
    {
     "text": "нормально.",
     "start": 10.054,
     "end": 10.716
    }
   ]
  },
  {
   "id": 5,
   "speaker": "narrator",
   "text": "Надень наушники пилота.",
   "start": 10.967,
   "end": 12.499,
   "words": [
    {
     "text": "Надень",
     "start": 10.967,
     "end": 11.443
    },
    {
     "text": "наушники",
     "start": 11.489,
     "end": 11.896
    },
    {
     "text": "пилота.",
     "start": 11.931,
     "end": 12.5
    }
   ]
  },
  {
   "id": 6,
   "speaker": "narrator",
   "text": "Найди кнопку на штурвале.",
   "start": 12.749,
   "end": 14.282,
   "words": [
    {
     "text": "Найди",
     "start": 12.749,
     "end": 13.062
    },
    {
     "text": "кнопку",
     "start": 13.097,
     "end": 13.422
    },
    {
     "text": "на",
     "start": 13.457,
     "end": 13.504
    },
    {
     "text": "штурвале.",
     "start": 13.538,
     "end": 14.282
    }
   ]
  },
  {
   "id": 7,
   "speaker": "narrator",
   "text": "Зажми и скажи: «Мэйдэй, Мэйдэй, Мэйдэй».",
   "start": 14.532,
   "end": 17.225,
   "words": [
    {
     "text": "Зажми",
     "start": 14.532,
     "end": 14.822
    },
    {
     "text": "и",
     "start": 14.869,
     "end": 14.892
    },
    {
     "text": "скажи:",
     "start": 14.927,
     "end": 15.31
    },
    {
     "text": "«Мэйдэй,",
     "start": 15.38,
     "end": 16.018
    },
    {
     "text": "Мэйдэй,",
     "start": 16.076,
     "end": 16.552
    },
    {
     "text": "Мэйдэй».",
     "start": 16.61,
     "end": 17.226
    }
   ]
  },
  {
   "id": 8,
   "speaker": "narrator",
   "text": "Тишина.",
   "start": 17.625,
   "end": 18.461,
   "words": [
    {
     "text": "Тишина.",
     "start": 17.625,
     "end": 18.461
    }
   ]
  },
  {
   "id": 9,
   "speaker": "narrator",
   "text": "И вдруг —",
   "start": 18.711,
   "end": 19.458,
   "words": [
    {
     "text": "И",
     "start": 18.711,
     "end": 18.943
    },
    {
     "text": "вдруг",
     "start": 19.001,
     "end": 19.338
    }
   ]
  },
  {
   "id": 10,
   "speaker": "dispatcher",
   "text": "Слышу вас. Автопилот не трогайте.",
   "start": 19.708,
   "end": 22.194,
   "words": [
    {
     "text": "Слышу",
     "start": 19.798,
     "end": 20.274
    },
    {
     "text": "вас.",
     "start": 20.309,
     "end": 20.599
    },
    {
     "text": "Автопилот",
     "start": 20.669,
     "end": 21.168
    },
    {
     "text": "не",
     "start": 21.214,
     "end": 21.284
    },
    {
     "text": "трогайте.",
     "start": 21.331,
     "end": 22.074
    }
   ]
  },
  {
   "id": 11,
   "speaker": "narrator",
   "text": "Видишь зелёную надпись «Эй-Пи»?",
   "start": 22.444,
   "end": 24.394,
   "words": [
    {
     "text": "Видишь",
     "start": 22.444,
     "end": 22.827
    },
    {
     "text": "зелёную",
     "start": 22.862,
     "end": 23.164
    },
    {
     "text": "надпись",
     "start": 23.21,
     "end": 23.524
    },
    {
     "text": "«Эй-Пи»?",
     "start": 23.605,
     "end": 24.394
    }
   ]
  },
  {
   "id": 12,
   "speaker": "narrator",
   "text": "Значит, самолёт пока летит сам.",
   "start": 24.644,
   "end": 26.502,
   "words": [
    {
     "text": "Значит,",
     "start": 24.644,
     "end": 25.236
    },
    {
     "text": "самолёт",
     "start": 25.294,
     "end": 25.631
    },
    {
     "text": "пока",
     "start": 25.677,
     "end": 25.84
    },
    {
     "text": "летит",
     "start": 25.886,
     "end": 26.118
    },
    {
     "text": "сам.",
     "start": 26.165,
     "end": 26.502
    }
   ]
  },
  {
   "id": 13,
   "speaker": "narrator",
   "text": "Дыши.",
   "start": 26.752,
   "end": 27.448,
   "words": [
    {
     "text": "Дыши.",
     "start": 26.752,
     "end": 27.449
    }
   ]
  },
  {
   "id": 14,
   "speaker": "dispatcher",
   "text": "Крутите ручку высоты. Снижаемся до трёхсот метров.",
   "start": 27.698,
   "end": 31.02,
   "words": [
    {
     "text": "Крутите",
     "start": 27.788,
     "end": 28.252
    },
    {
     "text": "ручку",
     "start": 28.287,
     "end": 28.566
    },
    {
     "text": "высоты.",
     "start": 28.589,
     "end": 29.053
    },
    {
     "text": "Снижаемся",
     "start": 29.216,
     "end": 29.75
    },
    {
     "text": "до",
     "start": 29.808,
     "end": 29.889
    },
    {
     "text": "трёхсот",
     "start": 29.924,
     "end": 30.273
    },
    {
     "text": "метров.",
     "start": 30.331,
     "end": 30.899
    }
   ]
  },
  {
   "id": 15,
   "speaker": "narrator",
   "text": "Стрелка ползёт вниз.",
   "start": 31.27,
   "end": 32.617,
   "words": [
    {
     "text": "Стрелка",
     "start": 31.27,
     "end": 31.781
    },
    {
     "text": "ползёт",
     "start": 31.827,
     "end": 32.106
    },
    {
     "text": "вниз.",
     "start": 32.164,
     "end": 32.617
    }
   ]
  },
  {
   "id": 16,
   "speaker": "narrator",
   "text": "Уши закладывает.",
   "start": 32.867,
   "end": 34.074,
   "words": [
    {
     "text": "Уши",
     "start": 32.867,
     "end": 33.25
    },
    {
     "text": "закладывает.",
     "start": 33.297,
     "end": 34.074
    }
   ]
  },
  {
   "id": 17,
   "speaker": "narrator",
   "text": "Впереди появляется полоса.",
   "start": 34.324,
   "end": 35.856,
   "words": [
    {
     "text": "Впереди",
     "start": 34.324,
     "end": 34.754
    },
    {
     "text": "появляется",
     "start": 34.8,
     "end": 35.276
    },
    {
     "text": "полоса.",
     "start": 35.311,
     "end": 35.857
    }
   ]
  },
  {
   "id": 18,
   "speaker": "narrator",
   "text": "Выпускаешь закрылки.",
   "start": 36.106,
   "end": 37.36,
   "words": [
    {
     "text": "Выпускаешь",
     "start": 36.106,
     "end": 36.71
    },
    {
     "text": "закрылки.",
     "start": 36.745,
     "end": 37.36
    }
   ]
  },
  {
   "id": 19,
   "speaker": "narrator",
   "text": "Скорость падает до двухсот шестидесяти.",
   "start": 37.61,
   "end": 39.7,
   "words": [
    {
     "text": "Скорость",
     "start": 37.61,
     "end": 38.016
    },
    {
     "text": "падает",
     "start": 38.074,
     "end": 38.365
    },
    {
     "text": "до",
     "start": 38.423,
     "end": 38.527
    },
    {
     "text": "двухсот",
     "start": 38.562,
     "end": 38.922
    },
    {
     "text": "шестидесяти.",
     "start": 38.968,
     "end": 39.7
    }
   ]
  },
  {
   "id": 20,
   "speaker": "narrator",
   "text": "Опускаешь шасси.",
   "start": 39.95,
   "end": 41.39,
   "words": [
    {
     "text": "Опускаешь",
     "start": 39.95,
     "end": 40.542
    },
