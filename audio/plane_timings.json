   "end": 54.307,
   "words": [
    {
     "text": "Стоп.",
     "start": 52.449,
     "end": 52.821
    },
    {
     "text": "Плавно.",
     "start": 52.879,
     "end": 53.297
    },
    {
     "text": "Крылья",
     "start": 53.366,
     "end": 53.691
    },
