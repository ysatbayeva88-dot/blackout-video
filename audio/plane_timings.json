     "text": "шасси.",
     "start": 40.647,
     "end": 41.39
    }
   ]
  },
  {
   "id": 21,
   "speaker": "narrator",
   "text": "Три зелёные лампы.",
   "start": 41.64,
   "end": 42.754,
   "words": [
    {
     "text": "Три",
     "start": 41.64,
     "end": 41.884
    },
    {
