{
 "duration": 62.745,
 "segments": [
  {
   "id": 0,
   "speaker": "narrator",
   "text": "Буран. Минус тридцать. Ты заперт в машине посреди степи.",
   "start": 0.0,
   "end": 3.111,
   "words": [
    {
     "text": "Буран.",
     "start": 0.0,
     "end": 0.418
    },
    {
     "text": "Минус",
     "start": 0.488,
     "end": 0.743
    },
    {
     "text": "тридцать.",
     "start": 0.789,
     "end": 1.207
    },
    {
     "text": "Ты",
     "start": 1.254,
     "end": 1.358
    },
    {
     "text": "заперт",
     "start": 1.416,
     "end": 1.73
    },
    {
     "text": "в",
     "start": 1.776,
     "end": 1.8
    },
    {
     "text": "машине",
     "start": 1.858,
     "end": 2.183
    },
    {
     "text": "посреди",
     "start": 2.229,
     "end": 2.601
    },
    {
     "text": "степи.",
     "start": 2.635,
     "end": 3.111
    }
   ]
  },
  {
   "id": 1,
   "speaker": "narrator",
   "text": "Асность, слушай меня.",
   "start": 3.311,
   "end": 4.937,
   "words": [
    {
     "text": "Асность,",
     "start": 3.311,
     "end": 3.926
    },
    {
     "text": "слушай",
     "start": 4.066,
     "end": 4.437
    },
    {
     "text": "меня.",
     "start": 4.484,
     "end": 4.936
    }
   ]
  },
  {
   "id": 2,
   "speaker": "narrator",
   "text": "Я, Алихан. Делай, как я скажу.",
   "start": 5.137,
   "end": 7.32,
   "words": [
    {
     "text": "Я,",
     "start": 5.137,
     "end": 5.659
    },
    {
     "text": "Алихан.",
     "start": 5.717,
     "end": 6.217
    },
    {
     "text": "Делай,",
     "start": 6.321,
     "end": 6.588
    },
    {
     "text": "как",
     "start": 6.611,
     "end": 6.716
    },
    {
     "text": "я",
     "start": 6.774,
     "end": 6.797
    },
    {
     "text": "скажу.",
     "start": 6.832,
     "end": 7.32
    }
   ]
  },
  {
   "id": 3,
   "speaker": "narrator",
   "text": "Ночная трасса. И вдруг, белая стена.",
   "start": 7.52,
   "end": 9.934,
   "words": [
    {
     "text": "Ночная",
     "start": 7.52,
     "end": 8.077
    },
    {
     "text": "трасса.",
     "start": 8.124,
     "end": 8.53
    },
    {
     "text": "И",
     "start": 8.577,
     "end": 8.623
    },
    {
     "text": "вдруг,",
     "start": 8.681,
     "end": 9.029
    },
    {
     "text": "белая",
     "start": 9.087,
     "end": 9.389
    },
    {
     "text": "стена.",
     "start": 9.424,
     "end": 9.935
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Удар. Машина в сугробе. Связи нет.",
   "start": 10.284,
   "end": 12.421,
   "words": [
    {
     "text": "Удар.",
     "start": 10.284,
     "end": 10.621
    },
    {
     "text": "Машина",
     "start": 10.702,
     "end": 11.039
    },
    {
     "text": "в",
     "start": 11.073,
     "end": 11.097
    },
    {
     "text": "сугробе.",
     "start": 11.143,
     "end": 11.619
    },
    {
     "text": "Связи",
     "start": 11.689,
     "end": 11.991
    },
    {
     "text": "нет.",
     "start": 12.037,
     "end": 12.42
    }
   ]
  },
  {
   "id": 5,
   "speaker": "narrator",
   "text": "Час первый.",
   "start": 12.621,
   "end": 13.503,
   "words": [
    {
     "text": "Час",
     "start": 12.621,
     "end": 12.934
    },
    {
     "text": "первый.",
     "start": 12.993,
     "end": 13.503
    }
   ]
  },
  {
   "id": 6,
   "speaker": "narrator",
   "text": "Не уходи от машины.",
   "start": 13.703,
   "end": 15.05,
   "words": [
    {
     "text": "Не",
     "start": 13.703,
     "end": 13.854
    },
    {
     "text": "уходи",
     "start": 13.889,
     "end": 14.191
    },
    {
     "text": "от",
     "start": 14.249,
     "end": 14.353
    },
    {
     "text": "машины.",
     "start": 14.411,
     "end": 15.05
    }
   ]
  },
  {
   "id": 7,
   "speaker": "narrator",
   "text": "В буране теряются в десяти шагах.",
   "start": 15.25,
   "end": 17.2,
   "words": [
    {
     "text": "В",
     "start": 15.25,
     "end": 15.482
    },
    {
     "text": "буране",
     "start": 15.552,
     "end": 15.854
    },
    {
     "text": "теряются",
     "start": 15.889,
     "end": 16.283
    },
    {
     "text": "в",
     "start": 16.307,
     "end": 16.33
    },
    {
     "text": "десяти",
     "start": 16.388,
     "end": 16.643
    },
    {
     "text": "шагах.",
     "start": 16.69,
     "end": 17.2
    }
   ]
  },
  {
   "id": 8,
   "speaker": "narrator",
   "text": "Машину спасатели найдут быстрее, чем человека.",
   "start": 17.4,
   "end": 20.28,
   "words": [
    {
     "text": "Машину",
     "start": 17.4,
     "end": 17.76
    },
    {
     "text": "спасатели",
     "start": 17.795,
     "end": 18.34
    },
    {
     "text": "найдут",
     "start": 18.41,
     "end": 18.724
    },
    {
     "text": "быстрее,",
     "start": 18.782,
     "end": 19.258
    },
    {
     "text": "чем",
     "start": 19.327,
     "end": 19.49
    },
    {
     "text": "человека.",
     "start": 19.548,
     "end": 20.279
    }
   ]
  },
  {
   "id": 9,
   "speaker": "narrator",
   "text": "Заводи мотор на десять минут в час. Береги бензин.",
   "start": 20.48,
   "end": 23.405,
   "words": [
    {
     "text": "Заводи",
     "start": 20.48,
     "end": 20.805
    },
    {
     "text": "мотор",
     "start": 20.852,
     "end": 21.13
    },
    {
     "text": "на",
     "start": 21.211,
     "end": 21.328
    },
    {
     "text": "десять",
     "start": 21.386,
     "end": 21.664
    },
    {
     "text": "минут",
     "start": 21.722,
     "end": 21.978
    },
    {
     "text": "в",
     "start": 22.036,
     "end": 22.071
    },
    {
     "text": "час.",
     "start": 22.14,
     "end": 22.419
    },
    {
     "text": "Береги",
     "start": 22.477,
     "end": 22.802
    },
    {
     "text": "бензин.",
     "start": 22.848,
     "end": 23.406
    }
   ]
  },
  {
   "id": 10,
   "speaker": "narrator",
   "text": "Приоткрой окно на щель.",
   "start": 23.605,
   "end": 24.998,
   "words": [
    {
     "text": "Приоткрой",
     "start": 23.605,
     "end": 24.093
    },
    {
     "text": "окно",
     "start": 24.151,
     "end": 24.36
    },
    {
     "text": "на",
     "start": 24.406,
     "end": 24.476
    },
    {
     "text": "щель.",
     "start": 24.534,
     "end": 24.998
    }
   ]
  },
  {
   "id": 11,
   "speaker": "narrator",
   "text": "Час двенадцатый.",
   "start": 25.198,
   "end": 26.266,
   "words": [
    {
     "text": "Час",
     "start": 25.198,
     "end": 25.465
    },
    {
     "text": "двенадцатый.",
     "start": 25.511,
     "end": 26.266
    }
   ]
  },
  {
   "id": 12,
   "speaker": "narrator",
   "text": "Машину замело по самые окна.",
   "start": 26.466,
   "end": 28.324,
   "words": [
    {
     "text": "Машину",
     "start": 26.466,
     "end": 26.988
    },
    {
     "text": "замело",
     "start": 27.046,
     "end": 27.325
    },
    {
     "text": "по",
     "start": 27.372,
     "end": 27.464
    },
    {
     "text": "самые",
     "start": 27.511,
     "end": 27.801
    },
    {
     "text": "окна.",
     "start": 27.859,
     "end": 28.324
    }
   ]
  },
  {
   "id": 13,
   "speaker": "narrator",
   "text": "Тепло. Клонит в сон.",
   "start": 28.524,
   "end": 29.824,
   "words": [
    {
     "text": "Тепло.",
     "start": 28.524,
     "end": 28.93
    },
    {
     "text": "Клонит",
     "start": 28.977,
     "end": 29.29
    },
    {
     "text": "в",
     "start": 29.325,
     "end": 29.36
    },
    {
     "text": "сон.",
     "start": 29.418,
     "end": 29.824
    }
   ]
  },
  {
   "id": 14,
   "speaker": "narrator",
   "text": "Стоп. Голова тяжёлая.",
   "start": 30.174,
   "end": 31.568,
   "words": [
    {
     "text": "Стоп.",
     "start": 30.174,
     "end": 30.499
    },
    {
     "text": "Голова",
     "start": 30.638,
     "end": 30.894
    },
    {
     "text": "тяжёлая.",
     "start": 30.94,
     "end": 31.567
    }
   ]
  },
  {
   "id": 15,
   "speaker": "narrator",
   "text": "Выхлопную трубу засыпало снегом.",
   "start": 31.768,
   "end": 33.904,
   "words": [
    {
     "text": "Выхлопную",
     "start": 31.768,
     "end": 32.407
    },
    {
     "text": "трубу",
     "start": 32.453,
     "end": 32.801
    },
    {
     "text": "засыпало",
     "start": 32.906,
     "end": 33.324
    },
    {
     "text": "снегом.",
     "start": 33.347,
     "end": 33.904
    }
   ]
  },
  {
   "id": 16,
   "speaker": "narrator",
   "text": "Угарный газ идёт в салон. Без запаха.",
   "start": 34.104,
   "end": 36.426,
   "words": [
    {
     "text": "Угарный",
     "start": 34.104,
     "end": 34.499
    },
    {
     "text": "газ",
     "start": 34.545,
     "end": 34.696
    },
    {
     "text": "идёт",
     "start": 34.766,
     "end": 34.963
    },
    {
     "text": "в",
     "start": 34.998,
     "end": 35.021
    },
    {
     "text": "салон.",
     "start": 35.068,
     "end": 35.381
    },
    {
     "text": "Без",
     "start": 35.451,
     "end": 35.671
    },
    {
     "text": "запаха.",
     "start": 35.753,
     "end": 36.426
    }
   ]
  },
  {
   "id": 17,
   "speaker": "narrator",
   "text": "Глуши мотор! Откапывай трубу!",
   "start": 37.026,
   "end": 38.79,
   "words": [
    {
     "text": "Глуши",
     "start": 37.026,
     "end": 37.351
    },
    {
     "text": "мотор!",
     "start": 37.398,
     "end": 37.711
    },
    {
     "text": "Откапывай",
     "start": 37.757,
     "end": 38.257
    },
    {
     "text": "трубу!",
     "start": 38.303,
     "end": 38.791
    }
   ]
  },
  {
   "id": 18,
   "speaker": "narrator",
   "text": "Ещё минута, и ты бы не проснулся.",
   "start": 39.14,
   "end": 41.184,
   "words": [
    {
     "text": "Ещё",
     "start": 39.14,
     "end": 39.535
    },
    {
     "text": "минута,",
     "start": 39.593,
     "end": 39.988
    },
    {
     "text": "и",
     "start": 40.046,
     "end": 40.104
    },
    {
     "text": "ты",
     "start": 40.15,
     "end": 40.22
    },
    {
     "text": "бы",
     "start": 40.255,
     "end": 40.313
    },
    {
     "text": "не",
     "start": 40.359,
     "end": 40.417
    },
    {
     "text": "проснулся.",
     "start": 40.452,
     "end": 41.183
    }
   ]
  },
  {
   "id": 19,
   "speaker": "narrator",
   "text": "День второй.",
   "start": 41.384,
   "end": 42.22,
   "words": [
    {
     "text": "День",
     "start": 41.384,
     "end": 41.628
    },
    {
     "text": "второй.",
     "start": 41.663,
     "end": 42.22
    }
   ]
  },
  {
   "id": 20,
   "speaker": "narrator",
   "text": "Яркий шарф, на антенну. Чтобы заметили.",
   "start": 42.42,
   "end": 44.602,
   "words": [
    {
     "text": "Яркий",
     "start": 42.42,
     "end": 42.687
    },
    {
     "text": "шарф,",
     "start": 42.733,
     "end": 43.024
    },
    {
     "text": "на",
     "start": 43.128,
     "end": 43.209
    },
    {
     "text": "антенну.",
     "start": 43.233,
     "end": 43.627
    },
    {
     "text": "Чтобы",
     "start": 43.732,
     "end": 43.976
    },
    {
     "text": "заметили.",
     "start": 44.022,
     "end": 44.603
    }
   ]
  },
  {
   "id": 21,
   "speaker": "narrator",
   "text": "Не ешь снег. Он отнимает тепло.",
   "start": 44.802,
   "end": 47.032,
   "words": [
    {
     "text": "Не",
     "start": 44.802,
     "end": 45.115
    },
    {
     "text": "ешь",
     "start": 45.139,
     "end": 45.301
    },
    {
     "text": "снег.",
     "start": 45.359,
     "end": 45.684
    },
    {
     "text": "Он",
     "start": 45.766,
     "end": 45.917
    },
    {
     "text": "отнимает",
     "start": 45.963,
     "end": 46.381
    },
    {
     "text": "тепло.",
     "start": 46.451,
     "end": 47.031
    }
   ]
  },
  {
   "id": 22,
   "speaker": "narrator",
   "text": "Растапливай его в бутылке под курткой.",
   "start": 47.232,
   "end": 49.321,
   "words": [
    {
     "text": "Растапливай",
     "start": 47.232,
     "end": 47.929
    },
    {
     "text": "его",
     "start": 47.987,
     "end": 48.149
    },
    {
     "text": "в",
     "start": 48.184,
     "end": 48.207
    },
    {
     "text": "бутылке",
     "start": 48.265,
     "end": 48.59
    },
    {
     "text": "под",
     "start": 48.625,
     "end": 48.73
    },
    {
     "text": "курткой.",
     "start": 48.776,
     "end": 49.322
    }
   ]
  },
  {
   "id": 23,
   "speaker": "narrator",
   "text": "День третий.",
   "start": 49.521,
   "end": 50.543,
   "words": [
    {
     "text": "День",
     "start": 49.521,
     "end": 49.951
    },
    {
     "text": "третий.",
     "start": 49.974,
     "end": 50.543
    }
   ]
  },
  {
   "id": 24,
   "speaker": "narrator",
   "text": "Бензин на нуле. В салоне минус пятнадцать.",
   "start": 50.743,
   "end": 53.204,
   "words": [
    {
     "text": "Бензин",
     "start": 50.743,
     "end": 51.207
    },
    {
     "text": "на",
     "start": 51.312,
     "end": 51.405
    },
    {
     "text": "нуле.",
     "start": 51.451,
     "end": 51.776
    },
    {
     "text": "В",
     "start": 51.811,
     "end": 51.869
    },
    {
     "text": "салоне",
     "start": 51.927,
     "end": 52.194
    },
    {
     "text": "минус",
     "start": 52.241,
     "end": 52.45
    },
    {
     "text": "пятнадцать.",
     "start": 52.496,
     "end": 53.204
    }
   ]
  },
  {
   "id": 25,
   "speaker": "narrator",
   "text": "Двигайся. Сжимай кулаки. Не спи.",
   "start": 53.404,
   "end": 55.773,
   "words": [
    {
     "text": "Двигайся.",
     "start": 53.404,
     "end": 53.996
    },
    {
     "text": "Сжимай",
     "start": 54.101,
     "end": 54.472
    },
    {
     "text": "кулаки.",
     "start": 54.519,
     "end": 54.96
    },
    {
     "text": "Не",
     "start": 55.076,
     "end": 55.192
    },
    {
     "text": "спи.",
     "start": 55.238,
     "end": 55.772
    }
   ]
  },
  {
   "id": 26,
   "speaker": "narrator",
   "text": "И вдруг в темноте, фары спасателей.",
   "start": 56.123,
   "end": 58.073,
   "words": [
    {
     "text": "И",
     "start": 56.123,
     "end": 56.193
    },
    {
     "text": "вдруг",
     "start": 56.251,
     "end": 56.483
    },
    {
     "text": "в",
     "start": 56.518,
     "end": 56.541
    },
    {
     "text": "темноте,",
     "start": 56.587,
     "end": 57.052
    },
    {
     "text": "фары",
     "start": 57.121,
     "end": 57.342
    },
    {
     "text": "спасателей.",
     "start": 57.377,
     "end": 58.073
    }
   ]
  },
  {
   "id": 27,
   "speaker": "narrator",
   "text": "Семьдесят два часа. Ты живой.",
   "start": 58.423,
   "end": 60.374,
   "words": [
    {
     "text": "Семьдесят",
     "start": 58.423,
     "end": 58.922
    },
    {
     "text": "два",
     "start": 58.992,
     "end": 59.131
    },
    {
     "text": "часа.",
     "start": 59.189,
     "end": 59.584
    },
    {
     "text": "Ты",
     "start": 59.654,
     "end": 59.758
    },
    {
     "text": "живой.",
     "start": 59.828,
     "end": 60.373
    }
   ]
  },
  {
   "id": 28,
   "speaker": "narrator",
   "text": "А ты бы выжил? Пиши в комментариях.",
   "start": 60.574,
   "end": 62.246,
   "words": [
    {
     "text": "А",
     "start": 60.574,
     "end": 60.655
    },
    {
     "text": "ты",
     "start": 60.713,
     "end": 60.795
    },
    {
     "text": "бы",
     "start": 60.829,
     "end": 60.899
    },
    {
     "text": "выжил?",
     "start": 60.934,
     "end": 61.247
    },
    {
     "text": "Пиши",
     "start": 61.294,
     "end": 61.503
    },
    {
     "text": "в",
     "start": 61.526,
     "end": 61.549
    },
    {
     "text": "комментариях.",
     "start": 61.607,
