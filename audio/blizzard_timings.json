{
 "duration": 61.477,
 "segments": [
  {
   "id": 0,
   "speaker": "narrator",
   "text": "Буран. Минус тридцать. Ты заперт в машине посреди степи.",
   "start": 0.0,
   "end": 3.065,
   "words": [
    {
     "text": "Буран.",
     "start": 0.0,
     "end": 0.43
    },
    {
     "text": "Минус",
     "start": 0.499,
     "end": 0.778
    },
    {
     "text": "тридцать.",
     "start": 0.813,
     "end": 1.231
    },
    {
     "text": "Ты",
     "start": 1.254,
     "end": 1.358
    },
    {
     "text": "заперт",
     "start": 1.416,
     "end": 1.73
    },
    {
     "text": "в",
     "start": 1.776,
     "end": 1.811
    },
    {
     "text": "машине",
     "start": 1.858,
     "end": 2.171
    },
    {
     "text": "посреди",
     "start": 2.206,
     "end": 2.589
    },
    {
     "text": "степи.",
     "start": 2.612,
     "end": 3.065
    }
   ]
  },
  {
   "id": 1,
   "speaker": "narrator",
   "text": "Асность, слушай меня.",
   "start": 3.265,
   "end": 4.658,
   "words": [
    {
     "text": "Асность,",
     "start": 3.265,
     "end": 3.822
    },
    {
     "text": "слушай",
     "start": 3.88,
     "end": 4.229
    },
    {
     "text": "меня.",
     "start": 4.263,
     "end": 4.658
    }
   ]
  },
  {
   "id": 2,
   "speaker": "narrator",
   "text": "Ночная трасса. И вдруг, белая стена.",
   "start": 4.858,
   "end": 7.134,
   "words": [
    {
     "text": "Ночная",
     "start": 4.858,
     "end": 5.357
    },
    {
     "text": "трасса.",
     "start": 5.404,
     "end": 5.822
    },
    {
     "text": "И",
     "start": 5.88,
     "end": 5.938
    },
    {
     "text": "вдруг,",
     "start": 5.984,
     "end": 6.298
    },
    {
     "text": "белая",
     "start": 6.332,
     "end": 6.599
    },
    {
     "text": "стена.",
     "start": 6.634,
     "end": 7.134
    }
   ]
  },
  {
   "id": 3,
   "speaker": "narrator",
   "text": "Удар. Машина в сугробе. Связи нет.",
   "start": 7.484,
   "end": 10.084,
   "words": [
    {
     "text": "Удар.",
     "start": 7.484,
     "end": 8.064
    },
    {
     "text": "Машина",
     "start": 8.227,
     "end": 8.575
    },
    {
     "text": "в",
     "start": 8.61,
     "end": 8.633
    },
    {
     "text": "сугробе.",
     "start": 8.668,
     "end": 9.179
    },
    {
     "text": "Связи",
     "start": 9.318,
     "end": 9.667
    },
    {
     "text": "нет.",
     "start": 9.725,
     "end": 10.085
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Час первый.",
   "start": 10.284,
   "end": 11.26,
   "words": [
    {
     "text": "Час",
     "start": 10.284,
     "end": 10.632
    },
    {
     "text": "первый.",
     "start": 10.702,
     "end": 11.259
    }
   ]
  },
  {
   "id": 5,
   "speaker": "narrator",
   "text": "Не уходи от машины.",
   "start": 11.46,
   "end": 12.899,
   "words": [
    {
     "text": "Не",
     "start": 11.46,
     "end": 11.634
    },
    {
     "text": "уходи",
     "start": 11.681,
     "end": 12.017
    },
    {
     "text": "от",
     "start": 12.064,
     "end": 12.133
    },
    {
     "text": "машины.",
     "start": 12.191,
     "end": 12.9
    }
   ]
  },
  {
   "id": 6,
   "speaker": "narrator",
   "text": "В буране теряются в десяти шагах.",
   "start": 13.099,
   "end": 15.096,
   "words": [
    {
     "text": "В",
     "start": 13.099,
     "end": 13.308
    },
    {
     "text": "буране",
     "start": 13.366,
     "end": 13.668
    },
    {
     "text": "теряются",
     "start": 13.714,
     "end": 14.132
    },
    {
     "text": "в",
     "start": 14.167,
     "end": 14.19
    },
    {
     "text": "десяти",
     "start": 14.237,
     "end": 14.55
    },
    {
     "text": "шагах.",
     "start": 14.573,
     "end": 15.096
    }
   ]
  },
  {
   "id": 7,
   "speaker": "narrator",
   "text": "Машину спасатели найдут быстрее, чем человека.",
   "start": 15.296,
   "end": 17.897,
   "words": [
    {
     "text": "Машину",
     "start": 15.296,
     "end": 15.691
    },
    {
     "text": "спасатели",
     "start": 15.726,
     "end": 16.213
    },
    {
     "text": "найдут",
     "start": 16.248,
     "end": 16.503
    },
    {
     "text": "быстрее,",
     "start": 16.55,
     "end": 16.968
    },
    {
     "text": "чем",
     "start": 16.991,
     "end": 17.119
    },
    {
     "text": "человека.",
     "start": 17.177,
     "end": 17.897
    }
   ]
  },
  {
   "id": 8,
   "speaker": "narrator",
   "text": "Заводи мотор на десять минут в час. Береги бензин.",
   "start": 18.097,
   "end": 20.744,
   "words": [
    {
     "text": "Заводи",
     "start": 18.097,
     "end": 18.457
    },
    {
     "text": "мотор",
     "start": 18.48,
     "end": 18.736
    },
    {
     "text": "на",
     "start": 18.794,
     "end": 18.863
    },
    {
     "text": "десять",
     "start": 18.91,
     "end": 19.165
    },
    {
     "text": "минут",
     "start": 19.2,
     "end": 19.421
    },
    {
     "text": "в",
     "start": 19.467,
     "end": 19.49
    },
    {
     "text": "час.",
     "start": 19.548,
     "end": 19.827
    },
    {
     "text": "Береги",
     "start": 19.885,
     "end": 20.198
    },
    {
     "text": "бензин.",
     "start": 20.222,
     "end": 20.744
    }
   ]
  },
  {
   "id": 9,
   "speaker": "narrator",
   "text": "Приоткрой окно на щель.",
   "start": 20.944,
   "end": 22.384,
   "words": [
    {
     "text": "Приоткрой",
     "start": 20.944,
     "end": 21.49
    },
    {
     "text": "окно",
     "start": 21.548,
     "end": 21.792
    },
    {
     "text": "на",
     "start": 21.815,
     "end": 21.896
    },
    {
     "text": "щель.",
     "start": 21.966,
     "end": 22.384
    }
   ]
  },
  {
   "id": 10,
   "speaker": "narrator",
   "text": "Час двенадцатый.",
   "start": 22.584,
   "end": 23.837,
   "words": [
    {
     "text": "Час",
     "start": 22.584,
     "end": 22.886
    },
    {
     "text": "двенадцатый.",
     "start": 22.944,
     "end": 23.838
    }
   ]
  },
  {
   "id": 11,
   "speaker": "narrator",
   "text": "Машину замело по самые окна.",
   "start": 24.037,
   "end": 26.081,
   "words": [
    {
     "text": "Машину",
     "start": 24.037,
     "end": 24.606
    },
    {
     "text": "замело",
     "start": 24.652,
     "end": 25.012
    },
    {
     "text": "по",
     "start": 25.07,
     "end": 25.186
    },
    {
     "text": "самые",
     "start": 25.244,
     "end": 25.558
    },
    {
     "text": "окна.",
     "start": 25.616,
     "end": 26.08
    }
   ]
  },
  {
   "id": 12,
   "speaker": "narrator",
   "text": "Тепло. Клонит в сон.",
   "start": 26.281,
   "end": 27.674,
   "words": [
    {
     "text": "Тепло.",
     "start": 26.281,
     "end": 26.734
    },
    {
     "text": "Клонит",
     "start": 26.815,
     "end": 27.163
    },
    {
     "text": "в",
     "start": 27.21,
     "end": 27.233
    },
    {
     "text": "сон.",
     "start": 27.279,
     "end": 27.674
    }
   ]
  },
  {
   "id": 13,
   "speaker": "narrator",
   "text": "Стоп. Голова тяжёлая.",
   "start": 28.024,
   "end": 29.464,
   "words": [
    {
     "text": "Стоп.",
     "start": 28.024,
     "end": 28.465
    },
    {
     "text": "Голова",
     "start": 28.57,
     "end": 28.872
    },
    {
     "text": "тяжёлая.",
     "start": 28.895,
     "end": 29.464
    }
   ]
  },
  {
   "id": 14,
   "speaker": "narrator",
   "text": "Выхлопную трубу засыпало снегом.",
   "start": 29.664,
   "end": 31.568,
   "words": [
    {
     "text": "Выхлопную",
     "start": 29.664,
     "end": 30.279
    },
    {
     "text": "трубу",
     "start": 30.326,
     "end": 30.581
    },
    {
     "text": "засыпало",
     "start": 30.616,
     "end": 31.022
    },
    {
     "text": "снегом.",
     "start": 31.057,
     "end": 31.568
    }
   ]
  },
  {
   "id": 15,
   "speaker": "narrator",
   "text": "Угарный газ идёт в салон. Без запаха.",
   "start": 31.768,
   "end": 33.997,
   "words": [
    {
     "text": "Угарный",
     "start": 31.768,
     "end": 32.163
    },
    {
     "text": "газ",
     "start": 32.209,
     "end": 32.348
    },
    {
     "text": "идёт",
     "start": 32.395,
     "end": 32.557
    },
    {
     "text": "в",
     "start": 32.604,
     "end": 32.627
    },
    {
     "text": "салон.",
     "start": 32.662,
     "end": 33.033
    },
    {
     "text": "Без",
     "start": 33.08,
     "end": 33.242
    },
    {
     "text": "запаха.",
     "start": 33.301,
     "end": 33.997
    }
   ]
  },
  {
   "id": 16,
   "speaker": "narrator",
   "text": "Глуши мотор! Откапывай трубу!",
   "start": 34.597,
   "end": 36.361,
   "words": [
    {
     "text": "Глуши",
     "start": 34.597,
     "end": 34.922
    },
    {
     "text": "мотор!",
     "start": 34.957,
     "end": 35.294
    },
    {
     "text": "Откапывай",
     "start": 35.328,
     "end": 35.804
    },
    {
     "text": "трубу!",
     "start": 35.839,
     "end": 36.362
    }
   ]
  },
  {
   "id": 17,
   "speaker": "narrator",
   "text": "Ещё минута, и ты бы не проснулся.",
   "start": 36.711,
   "end": 38.848,
   "words": [
    {
     "text": "Ещё",
     "start": 36.711,
     "end": 37.141
    },
    {
     "text": "минута,",
     "start": 37.199,
     "end": 37.617
    },
    {
     "text": "и",
     "start": 37.663,
     "end": 37.721
    },
    {
     "text": "ты",
     "start": 37.779,
     "end": 37.86
    },
    {
     "text": "бы",
     "start": 37.895,
     "end": 37.953
    },
    {
     "text": "не",
     "start": 38.0,
     "end": 38.069
    },
    {
     "text": "проснулся.",
     "start": 38.104,
     "end": 38.847
    }
   ]
  },
  {
   "id": 18,
   "speaker": "narrator",
   "text": "День второй.",
   "start": 39.048,
   "end": 39.976,
   "words": [
    {
     "text": "День",
     "start": 39.048,
     "end": 39.385
    },
    {
     "text": "второй.",
     "start": 39.408,
     "end": 39.977
    }
   ]
  },
  {
   "id": 19,
   "speaker": "narrator",
   "text": "Яркий шарф, на антенну. Чтобы заметили.",
   "start": 40.176,
   "end": 42.591,
   "words": [
    {
     "text": "Яркий",
     "start": 40.176,
     "end": 40.687
    },
    {
     "text": "шарф,",
     "start": 40.745,
     "end": 41.012
    },
    {
     "text": "на",
     "start": 41.035,
     "end": 41.093
    },
    {
     "text": "антенну.",
     "start": 41.116,
     "end": 41.616
    },
    {
     "text": "Чтобы",
     "start": 41.662,
     "end": 41.906
    },
    {
     "text": "заметили.",
     "start": 41.941,
     "end": 42.591
    }
   ]
  },
  {
   "id": 20,
   "speaker": "narrator",
   "text": "Не ешь снег. Он отнимает тепло.",
   "start": 42.791,
   "end": 45.02,
   "words": [
    {
     "text": "Не",
     "start": 42.791,
     "end": 43.116
    },
    {
     "text": "ешь",
     "start": 43.174,
     "end": 43.325
    },
    {
     "text": "снег.",
     "start": 43.348,
     "end": 43.685
    },
    {
     "text": "Он",
     "start": 43.848,
     "end": 43.998
    },
    {
     "text": "отнимает",
     "start": 44.056,
     "end": 44.474
    },
    {
     "text": "тепло.",
     "start": 44.532,
     "end": 45.02
    }
   ]
  },
  {
   "id": 21,
   "speaker": "narrator",
   "text": "Растапливай его в бутылке под курткой.",
   "start": 45.22,
   "end": 47.542,
   "words": [
    {
     "text": "Растапливай",
     "start": 45.22,
     "end": 45.94
    },
    {
     "text": "его",
     "start": 45.998,
     "end": 46.265
    },
    {
     "text": "в",
     "start": 46.3,
     "end": 46.358
    },
    {
     "text": "бутылке",
     "start": 46.416,
     "end": 46.787
    },
    {
     "text": "под",
     "start": 46.822,
     "end": 46.927
    },
    {
     "text": "курткой.",
     "start": 46.985,
     "end": 47.542
    }
   ]
  },
  {
   "id": 22,
   "speaker": "narrator",
   "text": "День третий.",
   "start": 47.742,
   "end": 48.811,
   "words": [
    {
     "text": "День",
     "start": 47.742,
     "end": 48.195
    },
    {
     "text": "третий.",
     "start": 48.23,
     "end": 48.81
    }
   ]
  },
  {
   "id": 23,
   "speaker": "narrator",
   "text": "Бензин на нуле. В салоне минус пятнадцать.",
   "start": 49.011,
   "end": 51.89,
   "words": [
    {
     "text": "Бензин",
     "start": 49.011,
     "end": 49.545
    },
    {
     "text": "на",
     "start": 49.766,
     "end": 49.87
    },
    {
     "text": "нуле.",
     "start": 49.905,
     "end": 50.23
    },
    {
     "text": "В",
     "start": 50.335,
     "end": 50.393
    },
    {
     "text": "салоне",
     "start": 50.451,
     "end": 50.764
    },
    {
     "text": "минус",
     "start": 50.811,
     "end": 51.054
    },
    {
     "text": "пятнадцать.",
     "start": 51.101,
     "end": 51.89
    }
   ]
  },
  {
   "id": 24,
   "speaker": "narrator",
   "text": "Двигайся. Сжимай кулаки. Не спи.",
   "start": 52.09,
   "end": 54.133,
   "words": [
    {
     "text": "Двигайся.",
     "start": 52.09,
     "end": 52.67
    },
    {
     "text": "Сжимай",
     "start": 52.729,
     "end": 53.077
    },
    {
     "text": "кулаки.",
     "start": 53.112,
     "end": 53.506
    },
    {
     "text": "Не",
     "start": 53.553,
     "end": 53.657
    },
    {
     "text": "спи.",
     "start": 53.681,
     "end": 54.133
    }
   ]
  },
  {
   "id": 25,
   "speaker": "narrator",
   "text": "И вдруг в темноте, фары спасателей.",
   "start": 54.483,
   "end": 56.48,
   "words": [
    {
     "text": "И",
     "start": 54.483,
     "end": 54.541
    },
    {
     "text": "вдруг",
     "start": 54.599,
     "end": 54.843
    },
    {
     "text": "в",
     "start": 54.878,
     "end": 54.913
    },
    {
     "text": "темноте,",
     "start": 54.959,
     "end": 55.458
    },
    {
     "text": "фары",
     "start": 55.528,
     "end": 55.748
    },
    {
     "text": "спасателей.",
     "start": 55.772,
     "end": 56.48
    }
   ]
  },
  {
   "id": 26,
   "speaker": "narrator",
   "text": "Семьдесят два часа. Ты живой.",
   "start": 56.83,
   "end": 58.92,
   "words": [
    {
     "text": "Семьдесят",
     "start": 56.83,
     "end": 57.457
    },
    {
     "text": "два",
     "start": 57.538,
     "end": 57.666
    },
    {
     "text": "часа.",
     "start": 57.712,
     "end": 58.119
    },
    {
     "text": "Ты",
     "start": 58.235,
     "end": 58.328
    },
    {
     "text": "живой.",
     "start": 58.386,
     "end": 58.92
    }
   ]
  },
  {
   "id": 27,
   "speaker": "narrator",
   "text": "А ты бы выжил? Пиши в комментариях.",
   "start": 59.12,
   "end": 60.977,
   "words": [
    {
     "text": "А",
     "start": 59.12,
     "end": 59.294
    },
    {
     "text": "ты",
     "start": 59.352,
     "end": 59.422
    },
    {
     "text": "бы",
     "start": 59.457,
     "end": 59.526
    },
    {
     "text": "выжил?",
     "start": 59.573,
     "end": 59.875
    },
    {
     "text": "Пиши",
     "start": 59.933,
     "end": 60.153
    },
    {
     "text": "в",
     "start": 60.177,
     "end": 60.2
    },
    {
     "text": "комментариях.",
     "start": 60.246,
     "end": 60.978
    }
   ]
  }
 ]
}