     "start": 35.598,
     "end": 35.897
    },
    {
     "text": "от",
     "start": 35.931,
     "end": 36.08
    },
    {
     "text": "толщины,",
     "start": 36.097,
     "end": 36.595
    },
    {
     "text": "а",
     "start": 36.651,
