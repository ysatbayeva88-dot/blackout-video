 "segments": [
  {
   "id": 0,
   "speaker": "narrator",
   "text": "Ты стал размером с муравья. И теперь всё хочет тебя убить.",
   "start": 0.0,
   "end": 2.972,
   "words": [
    {
     "text": "Ты",
     "start": 0.0,
     "end": 0.139
    },
    {
     "text": "стал",
     "start": 0.174,
     "end": 0.36
    },
    {
     "text": "размером",
     "start": 0.418,
     "end": 0.801
    },
    {
     "text": "с",
     "start": 0.859,
     "end": 0.882
    },
    {
     "text": "муравья.",
     "start": 0.929,
     "end": 1.37
    },
    {
     "text": "И",
     "start": 1.428,
     "end": 1.486
    },
    {
     "text": "теперь",
     "start": 1.544,
     "end": 1.811
    },
    {
     "text": "всё",
     "start": 1.834,
     "end": 1.962
    },
    {
     "text": "хочет",
     "start": 2.02,
     "end": 2.276
    },
    {
     "text": "тебя",
     "start": 2.31,
     "end": 2.543
    },
    {
     "text": "убить.",
     "start": 2.566,
     "end": 2.972
    }
   ]
  },
  {
   "id": 1,
   "speaker": "narrator",
   "text": "Асность, твой рост, три миллиметра.",
