     "end": 8.692
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Ты лёгкий, как пылинка. Воздух тормозит падение.",
   "start": 8.891,
   "end": 11.77,
   "words": [
    {
     "text": "Ты",
