   "end": 5.401,
   "words": [
    {
     "text": "Асность,",
     "start": 3.172,
     "end": 3.671
    },
    {
     "text": "твой",
     "start": 3.729,
     "end": 3.938
    },
    {
     "text": "рост,",
     "start": 3.996,
     "end": 4.368
    },
    {
     "text": "три",
     "start": 4.426,
     "end": 4.588
    },
    {
     "text": "миллиметра.",
     "start": 4.623,
     "end": 5.401
    }
   ]
  },
  {
   "id": 2,
   "speaker": "narrator",
   "text": "Ты падаешь со стола.",
   "start": 5.601,
   "end": 6.809,
   "words": [
    {
     "text": "Ты",
     "start": 5.601,
     "end": 5.787
    },
    {
     "text": "падаешь",
     "start": 5.833,
     "end": 6.17
    },
    {
     "text": "со",
     "start": 6.205,
     "end": 6.274
    },
    {
     "text": "стола.",
     "start": 6.298,
     "end": 6.808
    }
   ]
  },
  {
   "id": 3,
   "speaker": "narrator",
   "text": "И ничего. Ни царапины.",
   "start": 7.159,
   "end": 8.691,
   "words": [
    {
     "text": "И",
     "start": 7.159,
     "end": 7.322
    },
    {
     "text": "ничего.",
     "start": 7.38,
     "end": 7.809
    },
    {
     "text": "Ни",
     "start": 7.879,
     "end": 7.983
    },
    {
     "text": "царапины.",
     "start": 8.041,
     "end": 8.692
    }
   ]
  },
  {
   "id": 4,
   "speaker": "narrator",
   "text": "Ты лёгкий, как пылинка. Воздух тормозит падение.",
   "start": 8.891,
   "end": 11.77,
   "words": [
    {
     "text": "Ты",
     "start": 8.891,
     "end": 9.077
    },
    {
     "text": "лёгкий,",
     "start": 9.135,
     "end": 9.437
    },
    {
     "text": "как",
     "start": 9.46,
     "end": 9.588
    },
    {
     "text": "пылинка.",
     "start": 9.646,
     "end": 10.18
    },
    {
     "text": "Воздух",
     "start": 10.249,
     "end": 10.598
    },
    {
     "text": "тормозит",
     "start": 10.644,
     "end": 11.016
    },
    {
     "text": "падение.",
     "start": 11.062,
     "end": 11.77
    }
   ]
  },
  {
   "id": 5,
   "speaker": "narrator",
   "text": "Начинается дождь.",
   "start": 11.97,
   "end": 13.178,
   "words": [
    {
     "text": "Начинается",
     "start": 11.97,
     "end": 12.655
    },
    {
     "text": "дождь.",
     "start": 12.701,
     "end": 13.177
    }
   ]
  },
  {
   "id": 6,
   "speaker": "narrator",
   "text": "Одна капля весит в десятки раз больше тебя.",
   "start": 13.528,
   "end": 15.943,
   "words": [
    {
     "text": "Одна",
     "start": 13.528,
     "end": 13.888
    },
    {
     "text": "капля",
     "start": 13.923,
     "end": 14.201
    },
    {
     "text": "весит",
     "start": 14.236,
     "end": 14.468
    },
    {
     "text": "в",
     "start": 14.526,
     "end": 14.55
    },
    {
     "text": "десятки",
     "start": 14.608,
     "end": 14.933
    },
    {
     "text": "раз",
     "start": 14.979,
     "end": 15.095
    },
    {
     "text": "больше",
     "start": 15.153,
     "end": 15.42
    },
    {
     "text": "тебя.",
     "start": 15.467,
     "end": 15.943
    }
   ]
  },
  {
   "id": 7,
   "speaker": "narrator",
   "text": "Для тебя это, тонна воды с неба.",
   "start": 16.143,
   "end": 18.14,
   "words": [
    {
     "text": "Для",
     "start": 16.143,
     "end": 16.445
    },
    {
     "text": "тебя",
     "start": 16.48,
     "end": 16.7
    },
    {
     "text": "это,",
     "start": 16.758,
     "end": 17.002
    },
    {
     "text": "тонна",
     "start": 17.037,
     "end": 17.281
    },
    {
     "text": "воды",
     "start": 17.327,
     "end": 17.536
    },
    {
     "text": "с",
     "start": 17.571,
     "end": 17.606
    },
    {
     "text": "неба.",
     "start": 17.676,
     "end": 18.14
    }
   ]
  },
  {
   "id": 8,
   "speaker": "narrator",
   "text": "Удар! Тебя сбивает с ног.",
   "start": 18.34,
   "end": 20.197,
   "words": [
    {
     "text": "Удар!",
     "start": 18.34,
     "end": 18.932
    },
    {
     "text": "Тебя",
     "start": 19.013,
     "end": 19.304
    },
    {
     "text": "сбивает",
     "start": 19.327,
     "end": 19.71
    },
    {
     "text": "с",
     "start": 19.756,
     "end": 19.78
    },
    {
     "text": "ног.",
     "start": 19.838,
     "end": 20.198
    }
   ]
  },
  {
   "id": 9,
   "speaker": "narrator",
   "text": "Вода держит, как клей.",
   "start": 20.397,
   "end": 21.883,
   "words": [
    {
     "text": "Вода",
     "start": 20.397,
     "end": 20.873
    },
    {
     "text": "держит,",
     "start": 20.919,
     "end": 21.291
    },
    {
     "text": "как",
     "start": 21.314,
     "end": 21.43
    },
    {
     "text": "клей.",
     "start": 21.488,
     "end": 21.883
    }
   ]
  },
  {
   "id": 10,
   "speaker": "narrator",
   "text": "Это поверхностное натяжение. Оно в десятки раз сильнее твоего веса.",
   "start": 22.083,
   "end": 25.891,
   "words": [
    {
     "text": "Это",
     "start": 22.083,
     "end": 22.385
    },
    {
     "text": "поверхностное",
     "start": 22.42,
     "end": 23.012
    },
    {
     "text": "натяжение.",
     "start": 23.047,
     "end": 23.65
    },
    {
     "text": "Оно",
     "start": 23.72,
     "end": 23.941
    },
    {
     "text": "в",
     "start": 23.964,
     "end": 23.987
    },
    {
     "text": "десятки",
     "start": 24.045,
     "end": 24.417
    },
    {
     "text": "раз",
     "start": 24.463,
     "end": 24.614
    },
    {
     "text": "сильнее",
     "start": 24.637,
     "end": 24.962
    },
    {
     "text": "твоего",
     "start": 24.997,
     "end": 25.311
    },
    {
     "text": "веса.",
     "start": 25.334,
     "end": 25.891
    }
   ]
  },
  {
   "id": 11,
   "speaker": "narrator",
   "text": "Рвёшься наружу... а вода тянет обратно.",
   "start": 26.091,
   "end": 28.46,
   "words": [
    {
     "text": "Рвёшься",
     "start": 26.091,
     "end": 26.602
    },
    {
     "text": "наружу...",
     "start": 26.648,
     "end": 27.148
    },
    {
     "text": "а",
     "start": 27.206,
     "end": 27.264
    },
    {
     "text": "вода",
     "start": 27.298,
     "end": 27.554
    },
    {
     "text": "тянет",
     "start": 27.589,
     "end": 27.809
    },
    {
     "text": "обратно.",
     "start": 27.867,
     "end": 28.459
    }
   ]
  },
  {
   "id": 12,
   "speaker": "narrator",
   "text": "Ещё рывок. Свободен.",
