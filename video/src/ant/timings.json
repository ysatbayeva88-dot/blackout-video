     "start": 52.549,
     "end": 52.885
    },
    {
     "text": "для",
     "start": 52.92,
     "end": 53.048
    },
    {
     "text": "тебя",
     "start": 53.083,
     "end": 53.292
    },
    {
     "text": "теперь,",
     "start": 53.338,
     "end": 53.71
    },
    {
     "text": "обычная",
     "start": 53.768,
     "end": 54.197
    },
    {
     "text": "капля",
