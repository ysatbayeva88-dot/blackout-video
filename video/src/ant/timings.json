     "start": 13.923,
     "end": 14.201
    },
    {
     "text": "весит",
     "start": 14.236,
     "end": 14.468
    },
    {
     "text": "в",
     "start": 14.526,
     "end": 14.55
    },
    {
     "text": "десятки",
     "start": 14.608,
     "end": 14.933
    },
    {
     "text": "раз",
     "start": 14.979,
     "end": 15.095
