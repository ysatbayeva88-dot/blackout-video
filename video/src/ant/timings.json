     "start": 29.205,
     "end": 29.565
    },
    {
     "text": "Свободен.",
     "start": 29.623,
     "end": 30.25
    }
   ]
  },
  {
   "id": 13,
   "speaker": "narrator",
   "text": "Но плёнка воды на тебе тяжелее тебя самого.",
   "start": 30.45,
   "end": 32.864,
   "words": [
    {
     "text": "Но",
     "start": 30.45,
     "end": 30.589
    },
    {
     "text": "плёнка",
     "start": 30.624,
     "end": 30.938
    },
    {
     "text": "воды",
     "start": 30.984,
     "end": 31.216
    },
    {
     "text": "на",
     "start": 31.251,
     "end": 31.309
    },
    {
     "text": "тебе",
     "start": 31.356,
     "end": 31.553
    },
    {
     "text": "тяжелее",
     "start": 31.576,
     "end": 31.983
    },
    {
     "text": "тебя",
     "start": 32.017,
     "end": 32.25
    },
    {
     "text": "самого.",
     "start": 32.284,
     "end": 32.865
    }
   ]
  },
  {
   "id": 14,
   "speaker": "narrator",
   "text": "Зато теперь ты, суперсильный.",
   "start": 33.064,
   "end": 35.154,
   "words": [
    {
     "text": "Зато",
     "start": 33.064,
     "end": 33.482
    },
    {
     "text": "теперь",
     "start": 33.517,
     "end": 33.853
    },
    {
     "text": "ты,",
     "start": 33.877,
     "end": 34.097
    },
    {
     "text": "суперсильный.",
     "start": 34.202,
     "end": 35.154
    }
   ]
  },
  {
   "id": 15,
   "speaker": "narrator",
   "text": "Сила мышц, от толщины, а вес, от объёма. И вес упал сильнее.",
   "start": 35.354,
   "end": 39.209,
   "words": [
    {
     "text": "Сила",
     "start": 35.354,
     "end": 35.656
    },
    {
     "text": "мышц,",
     "start": 35.702,
     "end": 36.016
    },
    {
     "text": "от",
     "start": 36.062,
     "end": 36.155
    },
    {
     "text": "толщины,",
     "start": 36.26,
     "end": 36.747
    },
    {
     "text": "а",
     "start": 36.828,
     "end": 36.887
    },
    {
     "text": "вес,",
     "start": 36.933,
     "end": 37.223
    },
    {
     "text": "от",
     "start": 37.258,
     "end": 37.351
    },
    {
     "text": "объёма.",
     "start": 37.409,
     "end": 37.839
    },
    {
     "text": "И",
     "start": 37.885,
     "end": 37.943
    },
    {
     "text": "вес",
     "start": 38.001,
     "end": 38.152
    },
    {
     "text": "упал",
     "start": 38.21,
     "end": 38.407
    },
    {
     "text": "сильнее.",
     "start": 38.477,
     "end": 39.209
    }
   ]
  },
  {
   "id": 16,
   "speaker": "narrator",
   "text": "Рисинка в десятки раз тяжелее тебя. А ты несёшь её.",
   "start": 39.409,
   "end": 42.427,
   "words": [
    {
     "text": "Рисинка",
     "start": 39.409,
     "end": 39.862
    },
    {
     "text": "в",
     "start": 39.897,
     "end": 39.92
    },
    {
     "text": "десятки",
     "start": 39.978,
     "end": 40.373
    },
    {
     "text": "раз",
     "start": 40.419,
     "end": 40.535
    },
    {
     "text": "тяжелее",
     "start": 40.582,
     "end": 40.93
    },
    {
     "text": "тебя.",
     "start": 40.976,
     "end": 41.29
    },
    {
     "text": "А",
     "start": 41.348,
     "end": 41.406
    },
    {
     "text": "ты",
     "start": 41.464,
     "end": 41.534
    },
    {
     "text": "несёшь",
     "start": 41.592,
     "end": 41.94
    },
    {
     "text": "её.",
     "start": 41.975,
     "end": 42.428
    }
   ]
  },
  {
   "id": 17,
   "speaker": "narrator",
   "text": "Но тебе холодно. Маленькое тело остывает в сотни раз быстрее.",
   "start": 42.777,
   "end": 46.214,
   "words": [
    {
     "text": "Но",
     "start": 42.777,
     "end": 42.928
    },
    {
     "text": "тебе",
     "start": 42.986,
     "end": 43.195
    },
    {
     "text": "холодно.",
     "start": 43.253,
     "end": 43.694
    },
    {
     "text": "Маленькое",
     "start": 43.752,
     "end": 44.182
    },
    {
     "text": "тело",
     "start": 44.217,
     "end": 44.437
    },
    {
     "text": "остывает",
     "start": 44.495,
     "end": 44.913
    },
    {
     "text": "в",
     "start": 44.948,
     "end": 44.983
    },
    {
     "text": "сотни",
     "start": 45.018,
     "end": 45.32
    },
    {
     "text": "раз",
     "start": 45.436,
     "end": 45.587
    },
    {
     "text": "быстрее.",
     "start": 45.645,
     "end": 46.214
    }
   ]
  },
  {
   "id": 18,
   "speaker": "narrator",
   "text": "Трава, как небоскрёбы. Крошка хлеба, как валун.",
   "start": 46.414,
   "end": 49.061,
   "words": [
    {
     "text": "Трава,",
     "start": 46.414,
     "end": 46.855
    },
    {
     "text": "как",
     "start": 46.878,
     "end": 46.994
    },
    {
     "text": "небоскрёбы.",
     "start": 47.053,
     "end": 47.645
    },
    {
     "text": "Крошка",
     "start": 47.703,
     "end": 48.028
    },
    {
     "text": "хлеба,",
     "start": 48.074,
     "end": 48.399
    },
    {
     "text": "как",
     "start": 48.423,
     "end": 48.539
    },
    {
     "text": "валун.",
     "start": 48.597,
     "end": 49.061
    }
   ]
  },
  {
   "id": 19,
   "speaker": "narrator",
   "text": "И вдруг, топот. Муравей размером с лошадь.",
   "start": 49.411,
   "end": 52.012,
   "words": [
    {
     "text": "И",
     "start": 49.411,
     "end": 49.585
    },
    {
     "text": "вдруг,",
     "start": 49.643,
     "end": 49.968
    },
    {
     "text": "топот.",
     "start": 50.026,
     "end": 50.409
    },
    {
     "text": "Муравей",
     "start": 50.514,
     "end": 50.909
    },
    {
     "text": "размером",
     "start": 51.013,
     "end": 51.396
    },
    {
     "text": "с",
     "start": 51.454,
     "end": 51.478
    },
    {
     "text": "лошадь.",
     "start": 51.536,
     "end": 52.012
    }
   ]
  },
  {
